<sharedactionref id='6'>
<action title='Open Parent DB' icon='24'><code event='click'><lotusscript
>Sub Click(Source As Button)
	'workspace
	Dim workspace As New NotesUIWorkspace
	
	'view	
	Dim uiview As NotesUIView
	Set uiview = workspace.CurrentView
	Dim view As NotesView
	Set view = uiview.View
	
	'database
	Dim db As NotesDatabase
	Set db = view.Parent
	
	Call workspace.OpenDatabase( db.Server, db.FilePath, view.Name, , True, True)
End Sub
</lotusscript></code></action></sharedactionref></actionbar>

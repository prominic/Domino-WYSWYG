<code
 event='library'><javaproject class='JavaAgent.class' codepath='c:\Program Files\HCL\Notes\Data'
 compiledebug='true'><java name='net/prominic/mustache/MustacheRenderer.java'>package net.prominic.mustache;

import java.io.Reader;
import java.util.ArrayList;
import java.util.List;

import com.samskivert.mustache.Mustache;
import com.samskivert.mustache.Template;

import lotus.domino.Database;
import lotus.domino.Document;
import lotus.domino.NotesException;
import lotus.domino.View;
import net.prominic.DominoUtils;

/**
 * 2Renders Mustache templates stored as Template documents in ($templates),
 * replacing FreeMarker. JMustache is a single dependency-free jar doing pure
 * string parsing; with a Map-based data model there is no reflection at all.
 *
 * Per-request object: holds the request's view and the documents opened for
 * partials; call recycle() in a finally. Templates are compiled per request
 * (they are a few KB - parsing cost is negligible), so editing a Template
 * document is live on the next request.
 *
 * Partials: {{&gt; page.head}} resolves through the same ($templates) lookup.
 */
public class MustacheRenderer {
	private View m_view;
	private final List&lt;Document&gt; m_docs = new ArrayList&lt;Document&gt;();
	private final Mustache.Compiler m_compiler;

	public MustacheRenderer(Database database) throws NotesException {
		m_view = database.getView("($templates)");
		if (m_view == null) {
			throw new NotesException(0, "View not found: ($templates)");
		}

		m_compiler = Mustache.compiler()
				.defaultValue("")        // missing keys render as empty, not an error
				.emptyStringIsFalse(true) // {{#email}}...{{/email}} skips blank fields
				.withLoader(new Mustache.TemplateLoader() {
					public Reader getTemplate(String name) throws Exception {
						return readerFor(name.trim());
					}
				});
	}

	public String render(String id, Object data) throws Exception {
		Template template = m_compiler.compile(readerFor(id));
		return template.execute(data);
	}

	private Reader readerFor(String id) throws Exception {
		Document doc = m_view.getDocumentByKey(id, true);
		if (doc == null) {
			throw new Exception("Template not found: " + id);
		}
		m_docs.add(doc); // recycled in recycle(), after compile has consumed the reader
		return doc.getFirstItem("Body").getReader();
	}

	public void recycle() {
		for (Document doc : m_docs) {
			DominoUtils.recycle(doc);
		}
		m_docs.clear();
		DominoUtils.recycle(m_view);
		m_view = null;
	}
}
</java>

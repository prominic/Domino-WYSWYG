<code
 event='windowtitle'><formula>"Config"</formula></code>
<body><richtext>
<pardef id='1' hide='notes web mobile'/><subformref name='form.action'/>
<pardef id='2'/>
<par def='2'/>
<pardef id='3' leftmargin='1in' tabs='L0.5000in L1in L1.5000in L2in L2.5000in L3in L3.5000in L4in'/>
<par def='3'><run><font size='16pt'/>Config</run></par>
<par def='3'/>
<table cellbordercolor='silver' widthtype='fixedleft' refwidth='8in'><tablecolumn
 width='2in'/><tablecolumn width='6in'/>
<tablerow>
<tablecell>
<pardef id='5' keepwithnext='true' keeptogether='true'/>
<par def='5'>BaseURL</par></tablecell>
<tablecell>
<pardef id='6' keepwithnext='true' keeptogether='true'/>
<par def='6'><field type='text' kind='editable' name='BaseURL'><code event='defaultvalue'><formula
>"https://host/dir/domino-wysiwyg-demo.nsf"</formula></code><code event='inputtranslation'><formula
>@Trim(@ThisValue)</formula></code></field></par>
<par def='6'><run><font size='9pt' color='gray'/>Full URL of this NSF, no trailing slash. i.e. https://host/dir/domino-wysiwyg-demo.nsf</run></par></tablecell></tablerow>
<tablerow>
<tablecell>
<par def='5'>Data DB (Server !! Path)</par></tablecell>
<tablecell>
<par def='6'><field choicesdialog='addressbook' lookupeachchar='false' lookupaddressonrefresh='false'
 type='names' kind='editable' name='DataDbServer'><keywords columns='1' ui='dialoglist'
 allownew='true'/></field> <run><font style='bold' color='blue'/>!!</run> <field
 type='text' kind='editable' name='DataDbPath'><code event='defaultvalue'><formula
>"MOO\\MOOData.nsf"</formula></code></field></par>
<par def='6'><run><font size='9pt' color='gray'/>Where Contact and User documents live. Views used: ($contacts), ($users)</run></par></tablecell></tablerow>
<tablerow>
<tablecell>
<par def='5'>Version</par></tablecell>
<tablecell>
<par def='6'><field type='text' kind='editable' name='Version'><code event='defaultvalue'><formula
>"1.0"</formula></code></field></par></tablecell></tablerow></table>
<pardef id='7' firstlineleftmargin='1in'/>
<par def='7'/></richtext></body>
